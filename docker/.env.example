# =====================================================================
# Plantilla de configuración local. Copiar y rellenar:
#
#   cp docker/.env.example docker/.env
#
# docker/.env está ignorado por git: ahí van las credenciales y nunca se
# comitean. Compose lo lee solo, sin pasar ninguna opción extra.
#
# Sin este archivo el proyecto funciona igual: los valores por defecto
# apuntan a Mailpit y a la clave de desarrollo.
# =====================================================================

# --- Correo -----------------------------------------------------------
# Tal cual está aquí, todo va a Mailpit (http://localhost:8025) y ningún
# correo sale de la máquina. Es lo que conviene para el día a día: probar
# veinte veces no manda veinte correos a nadie.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
APP_MAIL_FROM=bitacora@localhost

# Para que los correos lleguen a un buzón real, comentar el bloque de
# arriba y descomentar este, con tu cuenta:
#
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=tu.cuenta@gmail.com
#   MAIL_PASSWORD=xxxxxxxxxxxxxxxx
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS=true
#   APP_MAIL_FROM=tu.cuenta@gmail.com
#
# MAIL_PASSWORD es una "contraseña de aplicación", no la del correo:
# se genera en https://myaccount.google.com/apppasswords y exige tener
# activada la verificación en dos pasos. Google la muestra en cuatro
# bloques de cuatro; los espacios son decorativos, se pegan seguidos.
#
# APP_MAIL_FROM tiene que ser la misma dirección que MAIL_USERNAME:
# Gmail solo permite enviar como la cuenta autenticada.

# --- Firma del JWT ----------------------------------------------------
# Mínimo 32 bytes o la aplicación no arranca (falla a propósito, para que
# nadie firme tokens con una clave corta sin darse cuenta).
APP_JWT_SECRET=clave-de-desarrollo-para-docker-cambiala-ya!!

# --- Front ------------------------------------------------------------
# Base del enlace que viaja en el correo. Lo abre el navegador del
# usuario, así que es una URL del host, no un nombre de servicio.
APP_FRONTEND_BASE_URL=http://localhost:3000

# --- Puertos del host -------------------------------------------------
# Descomentar si alguno está ocupado por otro servicio local.
# POSTGRES_HOST_PORT=5433
# MAILPIT_SMTP_PORT=1026
# MAILPIT_UI_PORT=8026
